# Copy this file to `.env` and fill in values. Never commit `.env`.

# Postgres connection string. The docker-compose default is:
DATABASE_URL=postgres://aviation:aviation@localhost:5432/aviation_weather

# Identifies our app to government weather APIs (they ask for this).
# Use your own contact email so NOAA can reach you if traffic misbehaves.
UPSTREAM_USER_AGENT="aviation-weather-planner (dev, you@example.com)"
