# Copy this file to `.env` and fill in values. Never commit `.env`.

# Postgres connection string. The docker-compose default is:
DATABASE_URL=postgres://aviation:aviation@localhost:5432/aviation_weather

# Identifies our app to government weather APIs (they ask for this).
# Use your own contact email so NOAA can reach you if traffic misbehaves.
UPSTREAM_USER_AGENT="aviation-weather-planner (dev, you@example.com)"

# --- Sign-in (required in production) ---
# Cookie-signing secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Email delivery for sign-in links (free key from https://resend.com).
# Leave empty to have sign-in links printed to the server log instead.
RESEND_API_KEY=
# With Resend's free tier you can send from this address without any
# domain setup — links can be delivered to your own Resend account email.
EMAIL_FROM=onboarding@resend.dev

# --- AI briefing chat (optional) ---
# API key from https://console.anthropic.com — enables "Ask about this
# briefing". Without it, everything else still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
